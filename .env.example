# Application configuration
COMPANY_NAME="Apex Technologies"
# Optional on Vercel (auto-detected from VERCEL_URL / request host if omitted)
APP_BASE_URL="http://localhost:3000"

# SMTP Configuration (Mailpit locally; on Vercel without external SMTP, emails appear at /demo/email-inbox)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Apex Gate Security <gate-security@apex.local>"

# OTP & Verification Settings
OTP_PROVIDER="host_screen"
REQUEST_EXPIRY_MINUTES="10"
OTP_EXPIRY_MINUTES="5"

# Database (PostgreSQL - e.g. Neon Postgres for Vercel)
DATABASE_URL="postgresql://user:password@localhost:5432/visitor_db?sslmode=prefer"
UPLOAD_DIR="./uploads"

# Security (set a strong random 32+ char secret in Vercel Environment Variables)
SESSION_SECRET="apex_super_secure_session_secret_key_minimum_32_characters_long"
