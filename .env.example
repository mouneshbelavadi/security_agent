# Application configuration
COMPANY_NAME="VS Techsol"
# Optional on Vercel (auto-detected from VERCEL_URL / request host if omitted)
APP_BASE_URL="http://localhost:3000"

# SMTP Configuration (Gmail SMTP for host arrival notifications and visitor OTP emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="VS Techsol Gate Security <your-gmail@gmail.com>"

# OTP & Verification Settings
OTP_PROVIDER="email"
REQUEST_EXPIRY_MINUTES="10"
OTP_EXPIRY_MINUTES="5"

# Database (PostgreSQL - e.g. Neon Postgres for Vercel)
DATABASE_URL="postgresql://user:password@localhost:5432/visitor_db?sslmode=prefer"
UPLOAD_DIR="./uploads"

# Security (set a strong random 32+ char secret in Vercel Environment Variables)
SESSION_SECRET="vstechsol_secure_session_secret_key_minimum_32_characters_long"
